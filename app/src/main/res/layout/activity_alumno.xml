<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Activities.ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- FOTO + BOTÓN -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/imgFoto"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                android:background="@drawable/circle_background"
                android:padding="4dp"
                android:contentDescription="@string/perfil_foto" />

            <Button
                android:id="@+id/btnTomarFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tomar_foto1"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- TARJETA DE INFORMACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nombre1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apellidos1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/direcci_n"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTelefono1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tel_fono"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tipo1"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- BOTONES DE ACCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnHorarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/horarios1"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnReuniones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reuniones1"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCiclos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ciclos1"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

        <!-- CAMBIAR TEMA -->
        <Button
            android:id="@+id/btnCambiarTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cambiar_tema"
            android:layout_marginBottom="24dp" />

        <!-- IDIOMAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnEs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ES" />

            <Button
                android:id="@+id/btnEu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EU" />

            <Button
                android:id="@+id/btnEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EN" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
